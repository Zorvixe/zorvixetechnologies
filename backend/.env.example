# Zorvixe Technologies Backend Environment Configuration (Example)
PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zorvixe
DATABASE_SSL=false
JWT_SECRET=replace-with-strong-random-secret
PUBLIC_BASE_URL=http://localhost:3000

# Initial Admin Seed (Optional)
ADMIN_EMAIL=admin@zorvixe.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_NAME=Administrator
ADMIN_ROLE=admin



# AI Provider Configuration (Keep credentials server-side only; NEVER expose in frontend/)
# Global kill switch: set to "false" to hard-disable all AI endpoints regardless of DB setting
AI_ENABLED=true
# Supported providers: openai | gemini | anthropic | fallback (default: auto-detect from API key, else deterministic fallback)
AI_PROVIDER=openai
# Model name (examples: gpt-4o-mini, gemini-2.0-flash, claude-3-5-haiku-latest)
AI_MODEL=gpt-4o-mini
# Optional custom OpenAI-compatible base URL (default: https://api.openai.com/v1)
# AI_BASE_URL=https://api.openai.com/v1
# Request timeout in ms (minimum 3000, default 18000)
AI_TIMEOUT_MS=18000
# Per-user 5-minute AI endpoint rate limit
AI_RATE_LIMIT_MAX=45

# Set ONE key corresponding to AI_PROVIDER (leave unset to run grounded analytical fallback engine)
# OPENAI_API_KEY=
GEMINI_API_KEY=AQ.Ab8RN6JPS95JxW6LVQWud3tyma_RpxuGdjDlNKu9iZnfJAnAUQ
# ANTHROPIC_API_KEY=
